local MAX_ESP_DISTANCE = 500
local FOV_LIMIT = 120
local aimSmoothness = 0.25

-- ==================== FUNCIONES DEL SCRIPT ====================
local function getClosestPlayer()
	local closest, shortest = nil, math.huge
	local myChar = player.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
	
	local center = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
	
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild(TARGET_PART) and p.Character:FindFirstChild("Humanoid") then
			local hum = p.Character.Humanoid
			if hum.Health > 0 then
				local part = p.Character[TARGET_PART]
				local dist3D = (myChar.HumanoidRootPart.Position - part.Position).Magnitude
				if dist3D > MAX_AIM_DISTANCE then continue end
				
				local screen, onScreen = camera:WorldToViewportPoint(part.Position)
				if onScreen then
					local dist2D = (Vector2.new(screen.X, screen.Y) - center).Magnitude
					if dist2D <= FOV_LIMIT and dist2D < shortest then
						shortest = dist2D
						closest = part
					end
				end
			end
		end
	end
	return closest
end

local function updateAimlock()
	if not aimlockEnabled then return end
	local target = getClosestPlayer()
	if target then
		local targetPos = target.Position + Vector3.new(0, 0.2, 0)
		local targetCFrame = CFrame.new(camera.CFrame.Position, targetPos)
		camera.CFrame = camera.CFrame:Lerp(targetCFrame, aimSmoothness)
	end
end

local drawings = {}

local function getBoxInfo(plr)
	local char = plr.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local head = char:FindFirstChild("Head")
	if not root or not head then return end
	
	local rPos = camera:WorldToViewportPoint(root.Position)
	local hPos = camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
	local lPos = camera:WorldToViewportPoint(root.Position - Vector3.new(0,3.5,0))
	
	if rPos.Z < 0 or hPos.Z < 0 then return end
	
	local height = math.abs(hPos.Y - lPos.Y) * 1.15
	local width = height * 0.55
	
	return {x = rPos.X - width/2, y = hPos.Y, w = width, h = height}
end

local function createDrawings(plr)
	if plr == player or drawings[plr] then return end
	local box = Drawing.new("Square")
	box.Thickness = 1.8 box.Color = Color3.fromRGB(255,50,50) box.Filled = false
	
	local name = Drawing.new("Text")
	name.Size = 15 name.Outline = true name.Center = true name.Font = Drawing.Fonts.UI
	
	local hBG = Drawing.new("Square") hBG.Filled = true hBG.Color = Color3.new(0,0,0) hBG.Transparency = 0.7
	local hBar = Drawing.new("Square") hBar.Filled = true
	
	drawings[plr] = {box=box, name=name, healthBG=hBG, healthBar=hBar}
end

local function removeDrawings(plr)
	if drawings[plr] then
		for _,v in pairs(drawings[plr]) do v:Remove() end
		drawings[plr] = nil
	end
end

local function updateESP()
	if not espEnabled then
		for _,d in pairs(drawings) do for _,v in pairs(d) do v.Visible = false end end
		return
	end
	
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	
	for _,plr in ipairs(Players:GetPlayers()) do
		if plr == player then continue end
		if not drawings[plr] then createDrawings(plr) end
		
		local char = plr.Character
		if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Head") or not char:FindFirstChild("Humanoid") then
			for _,v in pairs(drawings[plr] or {}) do v.Visible = false end continue
		end
		
		local hum = char.Humanoid
		if hum.Health <= 0 then
			for _,v in pairs(drawings[plr]) do v.Visible = false end continue
		end
		
		local root = char.HumanoidRootPart
		if myRoot and (myRoot.Position - root.Position).Magnitude > MAX_ESP_DISTANCE then
			for _,v in pairs(drawings[plr]) do v.Visible = false end continue
		end
		
		local info = getBoxInfo(plr)
		if not info then
			for _,v in pairs(drawings[plr]) do v.Visible = false end continue
		end
		
		local d = drawings[plr]
		local boxColor = plr.Team == player.Team and Color3.fromRGB(0,255,100) or Color3.fromRGB(255,50,50)
		d.box.Color = boxColor
		
		d.box.Visible = true
		d.box.Position = Vector2.new(info.x, info.y)
		d.box.Size = Vector2.new(info.w, info.h)
		
		local teamLower = (plr.Team and plr.Team.Name:lower()) or ""
		local nameColor = Color3.fromRGB(255,255,255)
		if teamLower:find("criminal") then nameColor = Color3.fromRGB(255,50,50)
		elseif teamLower:find("polic") or teamLower:find("polizei") then nameColor = Color3.fromRGB(50,120,255)
		elseif teamLower:find("civil") or teamLower:find("citizen") then nameColor = Color3.fromRGB(50,255,100) end
		
		d.name.Visible = true
		d.name.Text = plr.DisplayName .. " [" .. math.floor(hum.Health) .. "]"
		d.name.Color = nameColor
		d.name.Position = Vector2.new(info.x + info.w/2, info.y - 22)
		
		local hp = hum.Health / hum.MaxHealth
		d.healthBG.Visible = true
		d.healthBG.Position = Vector2.new(info.x-8, info.y)
		d.healthBG.Size = Vector2.new(5, info.h)
		
		d.healthBar.Visible = true
		d.healthBar.Position = Vector2.new(info.x-8, info.y + info.h*(1-hp))
		d.healthBar.Size = Vector2.new(5, info.h*hp)
		d.healthBar.Color = Color3.fromRGB(255-(255*hp), 255*hp, 0)
	end
end

local function enableFastPickup()
	for _,obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then obj.HoldDuration = 0 end
	end
end

local function disableFastPickup()
	for _,obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then obj.HoldDuration = 0.5 end
	end
end

local function startAntiTaser()
	if antiTaserLoop then antiTaserLoop:Disconnect() end
	antiTaserLoop = RunService.RenderStepped:Connect(function()
		local char = player.Character
		if char then
			local hum = char:FindFirstChild("Humanoid")
			if hum then
				hum.PlatformStand = false
				hum.Sit = false
				hum:ChangeState(Enum.HumanoidStateType.Running)
			end
		end
	end)
end

local function stopAntiTaser()
	if antiTaserLoop then
		antiTaserLoop:Disconnect()
		antiTaserLoop = nil
	end
end

