	local function updateButtons()
		aimBtn.Text = aimlockEnabled and "AIMLOCK: ON" or "AIMLOCK: OFF"
		aimBox.BackgroundColor3 = aimlockEnabled and Color3.fromRGB(0,220,100) or Color3.fromRGB(100,100,100)
		
		espBtn.Text = espEnabled and "ESP: ON" or "ESP: OFF"
		espBox.BackgroundColor3 = espEnabled and Color3.fromRGB(0,220,100) or Color3.fromRGB(100,100,100)
		
		fastBtn.Text = fastPickupEnabled and "LEVANTADO RAPIDO: ON" or "LEVANTADO RAPIDO: OFF"
		fastBox.BackgroundColor3 = fastPickupEnabled and Color3.fromRGB(0,220,100) or Color3.fromRGB(100,100,100)
		
		antiTaserBtn.Text = antiTaserEnabled and "ANTI TASER: ON" or "ANTI TASER: OFF"
		antiBox.BackgroundColor3 = antiTaserEnabled and Color3.fromRGB(0,220,100) or Color3.fromRGB(100,100,100)
	end
	
	aimBtn.MouseButton1Click:Connect(function() aimlockEnabled = not aimlockEnabled updateButtons() end)
	espBtn.MouseButton1Click:Connect(function() espEnabled = not espEnabled updateButtons() end)
	
	fastBtn.MouseButton1Click:Connect(function()
		fastPickupEnabled = not fastPickupEnabled
		updateButtons()
		if fastPickupEnabled then enableFastPickup() else disableFastPickup() end
		if fastPickupEnabled and not pickupConnection then
			pickupConnection = workspace.DescendantAdded:Connect(function(c) if c:IsA("ProximityPrompt") then c.HoldDuration = 0 end end)
		elseif not fastPickupEnabled and pickupConnection then
			pickupConnection:Disconnect() pickupConnection = nil
		end
	end)
	
	antiTaserBtn.MouseButton1Click:Connect(function()
		antiTaserEnabled = not antiTaserEnabled
		updateButtons()
		if antiTaserEnabled then startAntiTaser() else stopAntiTaser() end
	end)
	
	-- Distancia ESP
	btnCortaESP.MouseButton1Click:Connect(function() MAX_ESP_DISTANCE = 200 updateValueLabels() end)
	btnMediaESP.MouseButton1Click:Connect(function() MAX_ESP_DISTANCE = 500 updateValueLabels() end)
	btnLargaESP.MouseButton1Click:Connect(function() MAX_ESP_DISTANCE = 1000 updateValueLabels() end)
	
	-- Distancia AIMLOCK
	btnCortaAim.MouseButton1Click:Connect(function() MAX_AIM_DISTANCE = 100 updateValueLabels() end)
	btnMediaAim.MouseButton1Click:Connect(function() MAX_AIM_DISTANCE = 300 updateValueLabels() end)
	btnLargaAim.MouseButton1Click:Connect(function() MAX_AIM_DISTANCE = 500 updateValueLabels() end)
	
	-- Suavidad
	btnFuerte.MouseButton1Click:Connect(function()
		aimSmoothness = math.clamp(aimSmoothness - 0.05, 0.05, 0.95)
		updateValueLabels()
	end)
	btnSuave.MouseButton1Click:Connect(function()
		aimSmoothness = math.clamp(aimSmoothness + 0.05, 0.05, 0.95)
		updateValueLabels()
	end)
	
	-- Minimizar
	minimizeBtn.MouseButton1Click:Connect(function()
		minimized = not minimized
		if minimized then
			mainFrame.Size = UDim2.new(0, mainFrame.Size.X.Offset, 0, 60)
			scrollFrame.Visible = false
			minimizeBtn.Text = "+"
		else
			mainFrame.Size = originalSize
			scrollFrame.Visible = true
			minimizeBtn.Text = "−"
		end
	end)
	
	-- Arrastrar
	local dragging = false
	local dragStart, startPos
	title.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = mainFrame.Position
		end
	end)
	title.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	
	-- Tecla K
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then return end
		if input.KeyCode == Enum.KeyCode.K then
			mainFrame.Visible = not mainFrame.Visible
		end
	end)
	
	-- Loop
	connection = RunService.RenderStepped:Connect(function()
		updateAimlock()
		updateESP()
		if antiTaserEnabled then
			local char = player.Character
			if char then
				local hum = char:FindFirstChild("Humanoid")
				if hum then
					hum.PlatformStand = false
					hum.Sit = false
					hum:ChangeState(Enum.HumanoidStateType.Running)
				end
			end
		end
	end)
	
	for _,p in ipairs(Players:GetPlayers()) do createDrawings(p) end
	Players.PlayerAdded:Connect(createDrawings)
	Players.PlayerRemoving:Connect(removeDrawings)
	
	updateButtons()
	updateValueLabels()
end

